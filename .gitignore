# runtime / build artifacts — never committed
.venv/
# No trailing slash: after launcher/move-data-out-of-icloud.sh these are
# symlinks into ~/Library/Application Support, and `data/` matches only a
# directory — so the recommended layout left them showing as untracked.
# They hold an absolute, per-machine path either way.
data
packs
__pycache__/
*.egg-info/
*.pyc

# launcher runtime state (machine-specific)
.launcher.port
.launcher.log

# Holds absolute paths to whatever temp data dir last ran the preview, so it
# is per-machine by nature. Narrowed deliberately: `.claude/agent-memory/` is
# tracked, and ignoring the parent would make this file contradict the tree.
.claude/launch.json
